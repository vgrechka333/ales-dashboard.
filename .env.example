PORT=3000

# Ключ доступа к API Salebot (Настройки проекта -> API в личном кабинете Salebot)
SALEBOT_API_KEY=

# ID бота внутри проекта Salebot (необязательно — если не указать, будут учитываться клиенты всех ботов проекта)
SALEBOT_GROUP_ID=

# Как часто опрашивать Salebot, в минутах
POLL_INTERVAL_MINUTES=5
